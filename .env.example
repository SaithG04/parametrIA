POSTGRES_DB=parametria
POSTGRES_USER=parametria_user
POSTGRES_PASSWORD=replace-with-a-strong-local-password

REDIS_PASSWORD=replace-with-a-strong-local-password

MINIO_ROOT_USER=parametria_minio
MINIO_ROOT_PASSWORD=replace-with-a-strong-local-password
MINIO_BUCKET=parametria-documents
S3_ENDPOINT=http://localhost:19000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=parametria_minio
S3_SECRET_ACCESS_KEY=replace-with-the-MINIO_ROOT_PASSWORD

DATABASE_URL=postgresql://parametria_user:replace-with-a-strong-local-password@localhost:15432/parametria?schema=public
DATABASE_URL_DOCKER=postgresql://parametria_user:replace-with-a-strong-local-password@postgres:5432/parametria?schema=public
REDIS_URL=redis://:replace-with-a-strong-local-password@localhost:16379
REDIS_URL_DOCKER=redis://:replace-with-a-strong-local-password@redis:6379
RUN_EVALUATION_WORKER=true

PORT=3000
NODE_ENV=development
API_PREFIX=api
FRONTEND_ORIGINS=http://localhost:5173
ENCRYPTION_KEY=replace-with-64-hexadecimal-characters
ACCESS_TOKEN_SECRET=replace-with-at-least-32-random-bytes
REFRESH_TOKEN_SECRET=replace-with-a-different-32-random-bytes-secret
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
REFRESH_COOKIE_NAME=parametria_refresh
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=
JWT_ISSUER=parametria-api
JWT_AUDIENCE=parametria-web
IDEMPOTENCY_RETENTION_HOURS=24
TRUST_PROXY=false
DEMO_ADMIN_PASSWORD=replace-before-seeding
DEMO_INSTRUCTOR_PASSWORD=replace-before-seeding
DEMO_STUDENT_PASSWORD=replace-before-seeding

FRONTEND_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=ParametrIA <no-reply@example.com>
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_GREETING_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=30000
PASSWORD_RESET_TTL_SECONDS=1800
