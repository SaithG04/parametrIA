# Copy this file to .env.production and replace all CHANGE_ME values before deploying.
DOCKERHUB_NAMESPACE=saithg04
IMAGE_TAG=latest
SEED_MODE=admin-only

POSTGRES_DB=parametria
POSTGRES_USER=parametria
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_A_LONG_RANDOM_HEX_VALUE

REDIS_PASSWORD=CHANGE_ME_GENERATE_A_DIFFERENT_LONG_RANDOM_HEX_VALUE

MINIO_ROOT_USER=parametria_storage
MINIO_ROOT_PASSWORD=CHANGE_ME_GENERATE_ANOTHER_LONG_RANDOM_HEX_VALUE
MINIO_BUCKET=parametria-documents
S3_REGION=us-east-1

NODE_ENV=production
PORT=3000
API_PREFIX=api
FRONTEND_ORIGINS=https://parametria.example.com
FRONTEND_URL=https://parametria.example.com
ENCRYPTION_KEY=CHANGE_ME_64_HEX_CHARACTERS
ACCESS_TOKEN_SECRET=CHANGE_ME_GENERATE_A_RANDOM_SECRET
REFRESH_TOKEN_SECRET=CHANGE_ME_GENERATE_A_DIFFERENT_RANDOM_SECRET
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
REFRESH_COOKIE_NAME=parametria_refresh
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=
JWT_ISSUER=parametria-api
JWT_AUDIENCE=parametria-web
IDEMPOTENCY_RETENTION_HOURS=24
TRUST_PROXY=true
RUN_EVALUATION_WORKER=false

# Configure SMTP before enabling account invitations/password recovery.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=ParametrIA <no-reply@example.com>
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_GREETING_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=30000
PASSWORD_RESET_TTL_SECONDS=1800

# Used for the one-time initial superadmin. Keep private and change after first login.
DEMO_ADMIN_PASSWORD=CHANGE_ME_INITIAL_ADMIN_PASSWORD
